# Copy this file to .env.local and fill in the real values.

# WhatsApp number in international format, digits only (91 + 10-digit mobile).
# Every "Order on WhatsApp" button stays disabled until this is set.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional. Shown as a "Call us" button when set. Example: +91 98xxxxxxxx
NEXT_PUBLIC_PHONE_NUMBER=

# Optional. Full profile URLs. Leave blank to hide the icon.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Your live domain, used for SEO tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://example.com

